RIOT_API_KEY=replace_privately
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Local development; Compose supplies its own database URL.
DATABASE_URL=postgresql+psycopg://lanecoach:local-development-only@127.0.0.1:5432/lanecoach
# Railway service variables (set privately in Railway; leave local development unchanged).
# APP_ENV=production
# APP_SECRET=<generate a random secret of at least 32 characters>
# INTERNAL_PROXY_TOKEN=<another random secret, identical on web and API services>
# FRONTEND_ORIGIN=https://your-public-web-domain
# AI_DAILY_REQUEST_LIMIT=100
# AI_VISITOR_DAILY_LIMIT=10
# AI_VISITOR_MINUTE_LIMIT=3
